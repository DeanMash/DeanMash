# CloseLoop — contractor estimate follow-up system
DATABASE_URL=sqlite:///./closeloop.db
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=CloseLoop
APP_BASE_URL=http://127.0.0.1:8000

# Optional: real SMS (leave blank to log messages only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: real email (leave blank to log messages only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=followups@closeloop.local

# Demo mode seeds sample contractor + open estimates on startup
SEED_DEMO=true