# Get these from https://developers.deriv.com/ and your Deriv account API token settings
DERIV_APP_ID=1089
DERIV_API_TOKEN=your_deriv_api_token_here

# Comma-separated Deriv symbols to analyze (synthetic indices work 24/7)
DERIV_SYMBOLS=R_100,R_75,R_50,R_25,R_10

# How many recent ticks to fetch per symbol
TICK_COUNT=200

# Minimum confidence (0-100) required to show a suggestion
MIN_CONFIDENCE=55

# Optional: NewsAPI.org key for richer headlines (leave blank to use free RSS only)
NEWS_API_KEY=

# Telegram bot (phone access) — create with @BotFather
TELEGRAM_BOT_TOKEN=
# Optional but recommended: your Telegram chat id(s), comma-separated
# Send /chatid to the bot once to learn your id, then set it here
TELEGRAM_ALLOWED_CHAT_IDS=

# Web dashboard (browser / phone on same Wi‑Fi)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
# Optional shared secret — enter it in the dashboard Access token field
DASHBOARD_TOKEN=

# ComeHome (client win-back)
COMEHOME_HOST=0.0.0.0
COMEHOME_PORT=8080
COMEHOME_DASHBOARD_TOKEN=
COMEHOME_WHATSAPP_MODE=demo
COMEHOME_DB_PATH=
