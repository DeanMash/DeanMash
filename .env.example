# CloseLoop — contractor estimate follow-up system
DATABASE_URL=sqlite:///./closeloop.db
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=CloseLoop
APP_BASE_URL=http://127.0.0.1:8000
REGISTER_PATH=/register

# Optional: Twilio for WhatsApp (and SMS fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Optional: real email (leave blank to log messages only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=followups@closeloop.local

# Demo mode seeds sample contractor + open estimates on startup
# Demo login: demo@closeloop.local / demo1234
SEED_DEMO=true