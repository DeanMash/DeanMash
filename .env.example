# Get these from https://developers.deriv.com/ and your Deriv account API token settings
DERIV_APP_ID=1089
DERIV_API_TOKEN=your_deriv_api_token_here

# Comma-separated Deriv symbols/indices to analyze
# Examples: R_75,R_100,BOOM1000,CRASH1000,JD50,1HZ75V
DERIV_SYMBOLS=R_10,R_25,R_50,R_75,R_100,1HZ75V,1HZ100V,BOOM1000,CRASH1000,JD10,JD25,JD50,JD75,JD100

# How many recent ticks to fetch per symbol
TICK_COUNT=200

# Minimum confidence (0-100) required to show a suggestion
MIN_CONFIDENCE=55

# Optional: NewsAPI.org key for richer headlines (leave blank to use free RSS only)
NEWS_API_KEY=

# Optional: default Instagram links (space/comma separated) always included in analysis
INSTAGRAM_URLS=
# Optional: Facebook/Instagram oEmbed access token for more reliable captions
# Create an app at https://developers.facebook.com/ and use an app access token
FACEBOOK_ACCESS_TOKEN=

# Cache repeated news/ticks/report fetches (seconds). Set 0 to disable.
CACHE_TTL_SECONDS=45

# Telegram bot (phone access) — create with @BotFather
TELEGRAM_BOT_TOKEN=
# Optional but recommended: your Telegram chat id(s), comma-separated
# Send /chatid to the bot once to learn your id, then set it here
TELEGRAM_ALLOWED_CHAT_IDS=

# Scheduled high-confidence Telegram alerts (bot must be running)
ALERT_ENABLED=true
ALERT_INTERVAL_MINUTES=15
ALERT_MIN_CONFIDENCE=70
# Don't re-alert the same symbol+direction within this window
ALERT_COOLDOWN_MINUTES=30

# Web dashboard (browser / phone on same Wi‑Fi)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
# Optional shared secret — enter it in the dashboard Access token field
DASHBOARD_TOKEN=
