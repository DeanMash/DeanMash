# GladGate — copy to .env.local before going live

# Public URL (used in QR codes and links)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Mashtech control room login (required before launch)
MASHTECH_DASHBOARD_PASSWORD=change-this-strong-password
MASHTECH_SESSION_SECRET=long-random-string-for-cookie-signing

# EcoCash payment webhook (Mashtech server only)
ECOCASH_WEBHOOK_SECRET=mashtech-ecocash-live-secret
